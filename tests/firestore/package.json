{
  "name": "nexlib-firestore-rules-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "firebase emulators:exec --only firestore --project demo-nexlib \"node rules.test.mjs ../../firestore.rules && node spark.test.mjs\"",
