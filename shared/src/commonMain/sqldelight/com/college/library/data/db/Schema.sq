CREATE TABLE books (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    syncId TEXT NOT NULL UNIQUE,
    isbn TEXT NOT NULL,
    accNo TEXT NOT NULL,
    title TEXT NOT NULL,
    author TEXT NOT NULL,
    publisher TEXT NOT NULL,
    publisherPlace TEXT NOT NULL,
    publishDate TEXT NOT NULL,
    edition TEXT NOT NULL,
    pages INTEGER NOT NULL,
    procurement TEXT NOT NULL,
    volume TEXT NOT NULL,
    price REAL NOT NULL,
    status TEXT NOT NULL DEFAULT 'Available',
    isDigital INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    digitalUrl TEXT,
    category TEXT NOT NULL DEFAULT 'Uncategorized',
    marcData TEXT,
    lastUpdated INTEGER NOT NULL DEFAULT 0,
    deleted INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0
);

CREATE TABLE members (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    syncId TEXT NOT NULL UNIQUE,
    memberId TEXT NOT NULL UNIQUE,
    name TEXT NOT NULL,
    email TEXT NOT NULL,
    phone TEXT NOT NULL,
    department TEXT NOT NULL,
    memberType TEXT NOT NULL,
    joinDate TEXT NOT NULL,
    expiryDate TEXT NOT NULL,
    booksIssued INTEGER NOT NULL DEFAULT 0,
    fatherName TEXT NOT NULL DEFAULT '',
    className TEXT NOT NULL DEFAULT '',
    classNo TEXT NOT NULL DEFAULT '',
    address TEXT NOT NULL DEFAULT '',
    photoUri TEXT,
    designation TEXT NOT NULL DEFAULT '',
    bps TEXT NOT NULL DEFAULT '',
    pin TEXT NOT NULL DEFAULT '',
    lastUpdated INTEGER NOT NULL DEFAULT 0,
    deleted INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0
);

CREATE TABLE issued_books (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    syncId TEXT NOT NULL UNIQUE,
    bookId INTEGER NOT NULL,
    bookTitle TEXT NOT NULL,
    bookIsbn TEXT NOT NULL,
    memberId INTEGER NOT NULL,
    memberName TEXT NOT NULL,
    memberMemberId TEXT NOT NULL,
    issueDate TEXT NOT NULL,
    dueDate TEXT NOT NULL,
    returnDate TEXT,
    fine REAL NOT NULL DEFAULT 0.0,
    status TEXT NOT NULL DEFAULT 'Issued',
    lastUpdated INTEGER NOT NULL DEFAULT 0,
    deleted INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    FOREIGN KEY(bookId) REFERENCES books(id) ON DELETE CASCADE ON UPDATE CASCADE,
    FOREIGN KEY(memberId) REFERENCES members(id) ON DELETE CASCADE ON UPDATE CASCADE
);

CREATE TABLE reservations (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    syncId TEXT NOT NULL UNIQUE,
    bookId INTEGER NOT NULL,
    bookTitle TEXT NOT NULL,
    memberId INTEGER NOT NULL,
    memberName TEXT NOT NULL,
    reservedDate TEXT NOT NULL,
    status TEXT NOT NULL DEFAULT 'Pending',
    notifiedDate TEXT,
    lastUpdated INTEGER NOT NULL DEFAULT 0,
    deleted INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0
);

CREATE TABLE sync_conflicts (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    entityType TEXT NOT NULL,
    entityId TEXT NOT NULL,
    localValue TEXT NOT NULL,
    remoteValue TEXT NOT NULL,
    timestamp INTEGER NOT NULL,
    resolved INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0
);

CREATE TABLE book_requests (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    syncId TEXT NOT NULL UNIQUE,
    title TEXT NOT NULL,
    author TEXT NOT NULL,
    memberId INTEGER NOT NULL,
    memberName TEXT NOT NULL,
    requestDate TEXT NOT NULL,
    status TEXT NOT NULL DEFAULT 'Pending',
    lastUpdated INTEGER NOT NULL DEFAULT 0,
    deleted INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0
);

CREATE TABLE book_reviews (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    syncId TEXT NOT NULL UNIQUE,
    bookId INTEGER NOT NULL,
    memberId INTEGER NOT NULL,
    memberName TEXT NOT NULL,
    rating INTEGER NOT NULL,
    reviewText TEXT NOT NULL,
    reviewDate TEXT NOT NULL,
    lastUpdated INTEGER NOT NULL DEFAULT 0,
    deleted INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    FOREIGN KEY(bookId) REFERENCES books(id) ON DELETE CASCADE ON UPDATE CASCADE
);

CREATE TABLE agent_message_log (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    memberId INTEGER NOT NULL,
    memberName TEXT NOT NULL,
    memberPhone TEXT NOT NULL DEFAULT '',
    bookTitle TEXT NOT NULL,
    channel TEXT NOT NULL,
    message TEXT NOT NULL,
    sentDate TEXT NOT NULL,
    status TEXT NOT NULL DEFAULT 'Sent',
    lastUpdated INTEGER NOT NULL DEFAULT 0
);

-- BUG 4 FIX: Generic key-value metadata store for persisting sync cursors across
-- app restarts. The key "last_sync_timestamp" stores the epoch-millisecond value
-- of the last successful incremental pull so Firestore queries can use a delta
-- filter instead of re-fetching all documents on every cold start.
CREATE TABLE IF NOT EXISTS sync_metadata (
    key TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);
