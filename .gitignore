# ── Signing and credentials — never commit ───────────────────────────────────
# nexlib-release.jks WAS committed, together with its password in
# app/build.gradle.kts. It remains in git history: the key must be treated as
# compromised, rotated, and the history purged. See DEPLOYMENT.md.
*.jks
*.keystore
keystore.properties

