# GDC Library50 Desktop — Environment Configuration
# Copy this file to .env and fill in your values

# Path to your Firebase service account JSON key
FIREBASE_CRED_PATH=serviceAccountKey.json

# Leave these three EMPTY. They are filled in automatically when a librarian
# signs in or creates the institution on the onboarding screen. Setting them
# here pre-brands the app as one particular college, and every college given
# that copy would start pointed at that college's data.
COLLEGE_ID=

# Firebase project storage bucket (e.g. yourproject.appspot.com)
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# Firebase Web API Key (for Firebase Auth REST sign-in)
FIREBASE_WEB_API_KEY=your-firebase-web-api-key

# Auto-logout inactivity timeout in seconds (default 900 = 15 minutes)
INACTIVITY_TIMEOUT=900

# Fine rate per day (PKR)
DEFAULT_FINE_RATE=5.0

# App theme: dark or light
DEFAULT_THEME=dark

# Optional. Leave empty to run the AI Assistant (sidebar "AI ASSISTANT"
# button) in Local AI Mode — a real, working rule-based assistant with no
# ongoing cost, no external calls, and no key to manage. Set this only if
# you specifically want free-form natural-language understanding via
# Gemini function-calling instead; every action it can take (issuing a
# book, returning one, etc.) is identical either way, since both modes
# call the same functions in services/agent_service.py.
GEMINI_API_KEY=

# Directorate Central Server URL. localhost:8000 is for running the server
# on your own machine during development only — it is plain HTTP with no
# TLS, so pointing this at anything beyond localhost means every sync
# request (including the API key below) crosses the network unencrypted.
# A real deployment needs a reverse proxy terminating HTTPS in front of
# directorate_server/, and this should point at that https:// address.
DIRECTORATE_API_URL=http://localhost:8000

# Your college's API key, issued by the directorate when your college is
# registered with the central server (see directorate_server/main.py's
# POST /api/colleges/register) — not something you invent locally.
DIRECTORATE_API_KEY=

# Required by directorate_server/ (not by this desktop app) — a long,
# random secret that signs every directorate-admin login token. Generate
# one with: python -c "import secrets; print(secrets.token_hex(32))"
# The server refuses to start without this set; there is deliberately no
# default, since a guessable one would let anyone forge admin access.
JWT_SECRET=

# Comma-separated origins allowed to call directorate_server/ from a
# browser (the bundled directorate_dashboard/). Defaults to localhost only
# if unset — set this to your real dashboard's origin before deploying.
DIRECTORATE_DASHBOARD_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

COLLEGE_NAME=
COLLEGE_LOCATION=

# How often to push stats to directorate (minutes)
DIRECTORATE_SYNC_INTERVAL=5
