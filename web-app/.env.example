# NEXLIB web — Firebase configuration.
#
# These values are NOT secrets: they ship in every client bundle, and access is
# enforced by firestore.rules and custom claims, not by hiding them. They are
# here so a staging deployment can point at a different project without a code
# change.
#
# Every surface — web, director portal, Android, desktop — must point at the
# SAME project. A mix of dev and prod configs across platforms is what breaks
# the "one linked system" behaviour, and it fails silently: each app works
# perfectly on its own and simply never sees the others' data.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
